{
  "name": "applyonce-webextension",
  "version": "1.3.1",
  "private": true,
  "description": "Shared Safari, Chrome, and Edge ApplyOnce WebExtension.",
  "scripts": {
    "build:agent": "node scripts/build-agent.js",
    "build:chromium": "npm run build:agent && node scripts/build-extension.js",
    "package:chromium": "node scripts/package-extension.js",
    "test": "npm run build:agent && node --test tests/*.test.js",
    "vendor:llm": "node scripts/vendor-llm.js",
    "vendor:resume": "node scripts/vendor-resume.js",
    "vendor:llm:clean": "rm -rf 'ApplyOnce Extension/Resources/vendor/transformers'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/core": "1.2.11",
    "@langchain/langgraph": "1.4.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0"
  }
}
